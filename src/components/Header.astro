---
const currentPath = Astro.url.pathname;
---

<header class="bg-gray-900 text-white shadow-md sticky top-0 z-50">
    <nav class="container mx-auto px-4 h-16 flex items-center justify-between">
        
        <a href="/" class="text-xl font-bold uppercase tracking-wider hover:text-blue-400 transition-colors">
            Ewan<span class="text-blue-500">Company</span>
        </a>

        <div class="flex gap-8">
            <a 
                href="/" 
                class:list={[
                    "text-sm font-medium hover:text-blue-400 transition-colors",
                    currentPath === "/" ? "text-blue-500" : "text-gray-300"
                ]}
            >
                Accueil
            </a>

            <a 
                href="/offres" 
                class:list={[
                    "text-sm font-medium hover:text-blue-400 transition-colors",
                    currentPath.startsWith("/offres") ? "text-blue-500" : "text-gray-300"
                ]}
            >
                Offres
            </a>
        </div>

    </nav>
</header>