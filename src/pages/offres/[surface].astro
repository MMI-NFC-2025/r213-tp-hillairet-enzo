---
// src/pages/offres/surface/[surface].astro
import { filterBySurface } from '../../backend.mjs'; // Attention aux ../
import Layout from '../../layouts/Layout.astro';
import OffreCard from '../../components/OffreCard.astro'; // Si tu as recréé le composant, sinon copie le code de la carte

const { surface } = Astro.params;
const offres = await filterBySurface(surface);
---

<Layout titre={`Maisons > ${surface}m²`}>
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold mb-8">Maisons de plus de {surface} m²</h1>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {offres.map(offre => (
                 /* ... insère ici ton code de carte ou ton composant <OffreCard /> ... */
                 /* Pour faire simple, copie l'intérieur du map de ton index.astro */
                 <div class="border p-4 rounded bg-white">
                    <h2>{offre.nomMaison}</h2>
                    <p>{offre.surface} m²</p>
                    <a href={`/offres/${offre.id}`}>Voir</a>
                 </div>
            ))}
        </div>
    </div>
</Layout>