---
import { filterBySurface } from '../../js/backend.mjs';

import Layout from '../../layouts/Layout.astro';

import OffreCard from '../../components/OffreCard.astro'; 

const { surface } = Astro.params;
const offres = await filterBySurface(surface);
---

<Layout titre={`Maisons > ${surface}m²`}>
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold mb-8">Maisons de plus de {surface} m²</h1>
        
        {
            offres && offres.length > 0 ? (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {offres.map((offre) => (
                        <div class="offre">
                            <OffreCard offre={offre} />
                            <div class="mt-2 text-right">
                                <a href={`/offres/${offre.id}`} class="text-blue-600 hover:underline font-semibold">
                                    Voir détails
                                </a>
                            </div>
                        </div>
                    ))}
                </div>
            ) : (
                <div class="text-center py-12 bg-gray-50 rounded-lg">
                    <p class="text-gray-500 text-lg">Aucune maison trouvée supérieure à {surface} m².</p>
                    <a href="/offres" class="mt-4 inline-block text-blue-500 hover:underline">Voir toutes les offres</a>
                </div>
            )
        }
    </div>
</Layout>