---
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import OffreCard from "../../components/OffreCard.astro"; 
import { getOffres } from "../../js/backend.mjs"; 

const offres = await getOffres();
---

<Layout titre="Nos Offres">
    <div class="container mx-auto px-4 py-12 max-w-7xl">
        
        {/* EN-TÊTE DE PAGE */}
        <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-6">
            
            {/* Bloc Gauche : Titre + Lien en dessous */}
            <div class="w-full md:w-auto text-center md:text-left">
                <h1 class="text-4xl font-extrabold text-gray-900 mb-2">Offres Immobilières</h1>
                
                {/* Le lien est maintenant ici, sous le titre */}
                <a href="/offres/surface/80" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium hover:underline transition-colors group">
                    Voir les maisons de plus de 80 m²
         </div>

                    
                    {/* Petite flèche qui bouge au survol */}
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
            </div>
            
            {/* Bloc Droite : Recherche + Bouton Favoris */}
            <div class="flex w-full md:w-auto gap-3 items-center">
                <input 
                    type="text" 
                    id="search-input" 
                    placeholder="Rechercher une maison..." 
                    class="border border-gray-300 rounded-lg px-4 py-2 w-full md:w-64 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all shadow-sm"
                />

                <button 
                    id="favori-button" 
                    class="bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 hover:border-gray-400 font-medium py-2 px-4 rounded-lg flex items-center gap-2 transition-all shadow-sm whitespace-nowrap"
                >
                    <span class="grayscale transition-all duration-300 transform" id="heart-icon">❤️</span>
                    <span id="favori-text">Favoris</span>
                </button>
            </div>
        </div>

        {/* GRILLE DES OFFRES */}
        <div id="offres-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                offres.map((offre) => (
                    <div 
                        class="offre flex flex-col transition-all duration-500 ease-in-out" 
                        data-favori={offre.favori} 
                        data-nom={offre.nomMaison.toLowerCase()}
                    >
                        <OffreCard offre={offre} />
                        
                        <div class="mt-2 text-right">
                            <a href={`/offres/${offre.id}`} class="inline-flex items-center text-blue-600 hover:text-blue-800 font-semibold transition-colors">
                                Voir plus 
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                </svg>
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>

        {/* MESSAGE "AUCUN RÉSULTAT" */}
        <div id="no-result" class="hidden text-center py-20 bg-gray-50 rounded-xl border border-dashed border-gray-300 mt-8">
            <p class="text-xl text-gray-500">Aucune maison ne correspond à votre recherche.</p>
            <button id="reset-search" class="mt-2 text-blue-500 hover:underline text-sm">Réinitialiser les filtres</button>
        </div>
    </div>

    {/* SCRIPT DE FILTRAGE */}
    <script>
        // @ts-nocheck
        
        const btnFavori = document.getElementById('favori-button');
        const searchInput = document.getElementById('search-input');
        const offres = document.querySelectorAll('.offre');
        const noResult = document.getElementById('no-result');
        const heartIcon = document.getElementById('heart-icon');
        const resetBtn = document.getElementById('reset-search');
        
        let filterFavori = false;
        let filterText = '';

        function filterOffres() {
            let visibleCount = 0;

            offres.forEach(el => {
                const isFavori = el.dataset.favori === 'true';
                const nom = el.dataset.nom;
                
                const matchFavori = !filterFavori || isFavori;
                const matchText = nom.includes(filterText);

                if (matchFavori && matchText) {
                    el.style.display = 'flex'; 
                    visibleCount++;
                } else {
                    el.style.display = 'none';
                }
            });

            if (visibleCount === 0) {
                noResult.classList.remove('hidden');
            } else {
                noResult.classList.add('hidden');
            }
        }

        btnFavori?.addEventListener('click', () => {
            filterFavori = !filterFavori;
            
            if (filterFavori) {
                btnFavori.classList.add('bg-red-50', 'border-red-200', 'text-red-600');
                btnFavori.classList.remove('bg-white', 'border-gray-300', 'text-gray-700');
                heartIcon.classList.remove('grayscale', 'scale-100');
            } else {
                btnFavori.classList.remove('bg-red-50', 'border-red-200', 'text-red-600');
                btnFavori.classList.add('bg-white', 'border-gray-300', 'text-gray-700');
                heartIcon.classList.add('grayscale', 'scale-100');
                heartIcon.classList.remove('scale-125');
            }

            filterOffres();
        });

        searchInput?.addEventListener('input', (e) => {
            filterText = e.target.value.toLowerCase();
            filterOffres();
        });

        // Petit bonus : bouton reset si aucun résultat
        resetBtn?.addEventListener('click', () => {
            if(searchInput) searchInput.value = '';
            filterText = '';
            filterOffres();
        });
    </script>
</Layout>