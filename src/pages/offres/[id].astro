---
import "../../styles/global.css";
import { getOffre, getImageUrl } from '../../js/backend.mjs';
import Layout from '../../layouts/Layout.astro';

const { id } = Astro.params;
const offre = await getOffre(id);

if (!offre) {
    return Astro.redirect('/offres');
}

let imageFile = offre.images || offre.image || offre.img || offre.photos;

if (Array.isArray(imageFile)) {
        imageFile = imageFile[0];
}

const imgUrl = getImageUrl(offre, imageFile);
---

<Layout titre={offre.nomMaison}>
    <div class="container mx-auto px-4 py-12 max-w-7xl">
        
        <div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-4">
            <h1 class="text-4xl font-extrabold text-gray-900">
                {offre.nomMaison}
            </h1>
            
            <div class="flex w-full md:w-auto gap-3">
                <a href="/offres" class="bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 hover:border-gray-400 font-medium py-2 px-4 rounded-lg flex items-center gap-2 transition-all shadow-sm">
                    <span>←</span>
                    <span>Retour aux offres</span>
                </a>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100 flex flex-col md:flex-row">
            <div class="md:w-1/2 relative h-96 md:h-auto bg-gray-200">
                {imgUrl ? (
                    <img 
                        src={imgUrl} 
                        alt={offre.nomMaison} 
                        class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                    />
                ) : (
                    <div class="flex items-center justify-center h-full text-gray-400 font-medium">
                        Pas d'image disponible
                    </div>
                )}
            </div>
            <div class="p-8 md:w-1/2 flex flex-col justify-between">
                <div>
                    <h2 class="text-3xl font-bold text-gray-900 mb-2">{offre.nomMaison}</h2>
                    <p class="text-gray-500 text-lg mb-6 flex items-center">
                        📍 {offre.adresse}
                    </p>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-100">
                            <span class="block text-gray-500 text-sm uppercase font-semibold">Surface</span>
                            <span class="font-bold text-gray-900 text-xl">{offre.surface} m²</span>
                        </div>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-100">
                            <span class="block text-gray-500 text-sm uppercase font-semibold">Chambres</span>
                            <span class="font-bold text-gray-900 text-xl">{offre.nbChambres}</span>
                        </div>
                        <div class="bg-gray-50 p-4 rounded-lg border border-gray-100">
                            <span class="block text-gray-500 text-sm uppercase font-semibold">SDB</span>
                            <span class="font-bold text-gray-900 text-xl">{offre.nbSdb}</span>
                        </div>
                        <div class="bg-blue-50 p-4 rounded-lg border border-blue-100">
                            <span class="block text-blue-600 text-sm uppercase font-semibold">Prix</span>
                            <span class="font-bold text-blue-800 text-xl">{offre.prix} €</span>
                        </div>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-gray-100">
                    <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg transition-colors shadow-md">
                        Contacter l'agence
                    </button>
                </div>
            </div>
        </div>
    </div>
</Layout>